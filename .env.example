# Скопируйте в .env и заполните. Файл .env не выкладывать и никому не пересылать.

# Длинная случайная строка (например: openssl rand -hex 32)
DJANGO_SECRET_KEY=замените-на-случайную-строку
POSTGRES_PASSWORD=замените-на-пароль-базы

# Адреса, по которым открывают сервис (через запятую): IP сервера и/или домен
DJANGO_ALLOWED_HOSTS=192.168.1.10,localhost
# Если есть домен с HTTPS — укажите его с https:// и включите DJANGO_HTTPS
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS=0

# :80 — только внутри сети; домен (sklad.example.by) — из интернета с HTTPS
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Папка «Патрубки» на Яндекс.Диске
YANDEX_PUBLIC_URL=https://disk.yandex.by/d/L4tPbTCYDqEIEA
